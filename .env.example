# ---- Environment Suzuki BSB Website ----
# Salin jadi .env lalu isi sesuai lingkungan (lihat README §7 & §10).

# Database (WAJIB)
# Sandbox/dev (SQLite): file absolut ke db/custom.db
DATABASE_URL="file:/home/z/my-project/db/custom.db"
# Produksi (Supabase/PostgreSQL):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret HMAC sesi admin (WAJIB di produksi — generate: openssl rand -base64 48)
ADMIN_SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# URL publik situs — dipakai sitemap & JSON-LD (WAJIB di produksi)
NEXT_PUBLIC_SITE_URL="https://suzuki-bsb-semarang.example.com"

# Opsional: Cloudflare Turnstile (captcha alternatif, lihat src/lib/captcha.ts)
# TURNSTILE_SECRET_KEY=""

# ============================================================================
# CONTOH ENVIRONMENT VARIABLES — Suzuki BSB Website (sales-proto-4)
# Salin jadi `.env` lalu isi nilai asli. JANGAN pernah commit `.env`.
# ============================================================================

# ── DATABASE (WAJIB) ─────────────────────────────────────────────────────────
# Aplikasi mengakses Supabase Postgres via Prisma (BUKAN REST/anon key,
# BUKAN Supabase Auth). Connection string didapat dari:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
#
# Password DB yang mengandung karakter khusus WAJIB di-percent-encode
# (mis. '@' → '%40').
#
# Dev / server biasa (long-lived connection) — Shared/Session pooler, port 5432:
DATABASE_URL="postgresql://postgres.<project-ref>:<password-ter-encode>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Deploy Vercel/serverless (serverless function = koneksi singkat) —
# Transaction pooler, port 6543 + PgBouncer mode:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password-ter-encode>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#
# JEBAKAN: env var DATABASE_URL yang sudah ter-export di shell MENIMPA file
# .env (Next.js/bun tidak meng-override env yang sudah ada). Setelah mengganti
# .env, selalu `unset DATABASE_URL` dulu sebelum start server.

# ── SESSION ADMIN (WAJIB di production) ─────────────────────────────────────
# Secret HMAC untuk menandatangani cookie sesi admin (min 16 karakter).
# Generate: openssl rand -base64 48
# Tanpa variabel ini, dev memakai fallback deterministik (TIDAK aman utk produksi).
ADMIN_SESSION_SECRET=""

# ── OPSIONAL ────────────────────────────────────────────────────────────────
# Domain final produksi (untuk SEO/sitemap/JSON-LD):
# NEXT_PUBLIC_SITE_URL="https://www.suzukibsb.id"
#
# Cloudflare Turnstile (anti-bot tambahan; tanpa ini dipakai math captcha):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

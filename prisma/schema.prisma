// Suzuki Dealer Website — Prisma Schema
// SQLite di sandbox dev. Untuk production (Supabase/Vercel):
//   1. Ganti provider ke "postgresql" dan DATABASE_URL ke Supabase connection string.
//   2. Field JSON string (spesifikasi, galeri_gambar, tags) bisa dimigrasi ke tipe native (Json, String[]).
// Catatan: field memakai snake_case mengikuti kode legacy agar porting UI minim perubahan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("admins")
}

model Mobil {
  id            String   @id @default(uuid())
  nama          String
  slug          String   @unique
  kategori      String // passenger | commercial
  kategori_label String
  harga_mulai   Int?
  harga_label   String?
  seater        Int?
  fuel          String?
  transmission  String?
  deskripsi     String?
  spesifikasi   String   @default("{}") // JSON string: [{ label, value }]
  gambar_utama  String?
  galeri_gambar String   @default("[]") // JSON string: string[]
  warna         String   @default("[]") // JSON string: [{ nama, hex, gambar? }]
  is_new        Boolean  @default(false)
  is_published  Boolean  @default(true)
  urutan        Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  test_drives TestDrive[]

  @@map("mobil_katalog")
}

model Artikel {
  id          String    @id @default(uuid())
  judul       String
  slug        String    @unique
  ringkasan   String?
  konten      String
  cover_image String?
  tipe        String // PROMO | BERITA | KEGIATAN
  tags        String    @default("[]") // JSON string: string[]
  status      String    @default("DRAFT") // DRAFT | TERJADWAL | PUBLISHED
  published_at DateTime?
  scheduled_at DateTime?
  views       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("artikel")
}

model Pesan {
  id           String   @id @default(uuid())
  nama_lengkap String
  no_telepon   String
  email        String?
  subjek       String?
  pesan        String
  status       String   @default("BARU") // BARU | DIBACA | DIBALAS | SELESAI
  ip_address   String?
  user_agent   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("pesan_masuk")
}

model TestDrive {
  id                 String   @id @default(uuid())
  nama_lengkap       String
  no_telepon         String
  email              String
  mobil_id           String?
  mobil_pilihan      String
  tanggal_diinginkan DateTime
  waktu_diinginkan   String
  catatan            String?
  status             String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | DONE
  ip_address         String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  mobil Mobil? @relation(fields: [mobil_id], references: [id], onDelete: SetNull)

  @@map("test_drive")
}

model Testimoni {
  id         String   @id @default(uuid())
  nama       String
  rating     Int      @default(5) // 1–5
  pesan      String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  ip_address String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("testimoni")
}

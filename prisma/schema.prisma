// Suzuki Dealer Website — Prisma Schema
// TERHUBUNG KE SUPABASE POSTGRES (production) — sejak Task 18, dipulihkan
// ulang di Task 19 setelah reset sandbox.
//   - DATABASE_URL di .env → Supabase pooler (lihat .env.example & README §10).
//   - JANGAN jalankan `bun run db:push` terhadap Supabase — akan menganggap
//     kolom legacy (artikel.is_published, author_id) sebagai drift & ingin
//     menghapusnya. Perubahan schema → edit docs/supabase-setup.sql (idempoten).
// Catatan: field memakai snake_case mengikuti kode legacy agar porting UI minim perubahan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("admins")
}

model Mobil {
  id            String   @id @default(uuid())
  nama          String
  slug          String   @unique
  kategori      String // passenger | commercial
  kategori_label String
  harga_mulai   Int?
  harga_label   String?
  seater        Int?
  fuel          String?
  transmission  String?
  deskripsi     String?
  spesifikasi   String   @default("{}") // JSON string: [{ label, value }]
  gambar_utama  String?
  galeri_gambar String   @default("[]") // JSON string: string[]
  warna         String   @default("[]") // JSON string: [{ nama, hex, gambar? }]
  is_new        Boolean  @default(false)
  is_published  Boolean  @default(true)
  urutan        Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  test_drives TestDrive[]
  bookings_servis BookingServis[]

  @@map("mobil_katalog")
}

model Artikel {
  id          String    @id @default(uuid())
  judul       String
  slug        String    @unique
  ringkasan   String?
  konten      String
  cover_image String?
  tipe        String // PROMO | BERITA | KEGIATAN
  tags        String    @default("[]") // JSON string: string[]
  status      String    @default("DRAFT") // DRAFT | TERJADWAL | PUBLISHED
  published_at DateTime?
  scheduled_at DateTime?
  views       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("artikel")
}

model Pesan {
  id           String   @id @default(uuid())
  nama_lengkap String
  no_telepon   String
  email        String?
  subjek       String?
  pesan        String
  status       String   @default("BARU") // BARU | DIBACA | DIBALAS | SELESAI
  ip_address   String?
  user_agent   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("pesan_masuk")
}

model TestDrive {
  id                 String   @id @default(uuid())
  nama_lengkap       String
  no_telepon         String
  email              String
  mobil_id           String?
  mobil_pilihan      String
  tanggal_diinginkan DateTime
  waktu_diinginkan   String
  catatan            String?
  status             String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | DONE
  ip_address         String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  mobil Mobil? @relation(fields: [mobil_id], references: [id], onDelete: SetNull)

  @@map("test_drive")
}

model Testimoni {
  id         String   @id @default(uuid())
  nama       String
  rating     Int      @default(5) // 1–5
  pesan      String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  ip_address String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("testimoni")
}

model Faq {
  id          String   @id @default(uuid())
  kategori    String   @default("umum") // umum | pembelian | purnajual
  pertanyaan  String
  jawaban     String
  urutan      Int      @default(0)
  is_published Boolean @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([is_published, urutan])
  @@map("faqs")
}

model SubscriberNewsletter {
  id         String   @id @default(uuid())
  email      String   @unique
  status     String   @default("AKTIF") // AKTIF | BERHENTI (unsubscribe)
  ip_address String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, created_at])
  @@map("newsletter_subscribers")
}

model BookingServis {
  id                 String   @id @default(uuid())
  nama_lengkap       String
  no_telepon         String
  email              String?
  mobil_pilihan      String // nama mobil (dari katalog atau teks bebas utk mobil non-katalog)
  mobil_id           String? // FK opsional ke Mobil
  jenis_servis       String // servis-berkala | ganti-oli | tune-up | servis-berat | cek-kaki-kaki | lainnya
  tanggal_diinginkan DateTime
  waktu_diinginkan   String
  keluhan            String?
  status             String   @default("PENDING") // PENDING | CONFIRMED | DONE | CANCELLED
  ip_address         String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  mobil Mobil? @relation(fields: [mobil_id], references: [id], onDelete: SetNull)

  @@index([status, tanggal_diinginkan])
  @@map("booking_servis")
}
